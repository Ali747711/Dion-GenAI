# Copy to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=4100

# Postgres connection strings (Drizzle + postgres.js)
DATABASE_URL=postgres://localhost:5432/music_studio
TEST_DATABASE_URL=postgres://localhost:5432/music_studio_test

# Session / owner auth
SESSION_SECRET=replace-with-a-long-random-string
# Generate with: npm run hash-password -- "your-password"
OWNER_PASSWORD_HASH=replace-with-argon2-hash
OWNER_NAME=Owner

# Cookie behavior
COOKIE_SECURE=false

# Noiz provider
NOIZ_MODE=mock
NOIZ_BASE_URL=https://noiz.ai/v1
NOIZ_API_KEY=

# Local storage adapter
STORAGE_DIR=./storage
# Source file the mock provider "downloads" as the generated result (repo root music/audio.mp3)
MOCK_AUDIO_SOURCE_PATH=../music/audio.mp3

# Worker
WORKER_POLL_INTERVAL_MS=2000
WORKER_LEASE_MS=30000
WORKER_MAX_ATTEMPTS=6

# Logging
LOG_LEVEL=info

# CORS (only needed if the client is not served same-origin / not proxied by Vite)
CORS_ORIGIN=http://localhost:5173
